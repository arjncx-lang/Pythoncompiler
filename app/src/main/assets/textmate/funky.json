{
  "name": "Rose Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0F0E14",
    "editor.foreground": "#F2F2F5",
    "editor.selectionBackground": "#3A3550",
    "editor.lineHighlightBackground": "#1A1824",
    "editorCursor.foreground": "#FF2E63",
    "editorLineNumber.foreground": "#4A4759",
    "editorLineNumber.activeForeground": "#C8C5D6",
    "editorGutter.background": "#0F0E14"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6A9955", "fontStyle": "" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#E6DB74" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#FF8C42" } },
    { "scope": ["constant.numeric", "constant.character"], "settings": { "foreground": "#AE81FF" } },
    { "scope": ["constant.language", "constant.language.boolean", "constant.language.none"], "settings": { "foreground": "#AE81FF" } },
    { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#FF8C42" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#FF2E63" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#FF8C42" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#66D9EF" } },
    { "scope": ["variable", "meta.definition.variable.name", "variable.parameter", "variable.other"], "settings": { "foreground": "#F2F2F5" } },
    { "scope": ["variable.language.special.self", "variable.language"], "settings": { "foreground": "#FF2E63" } },
    { "scope": ["meta.function.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"], "settings": { "foreground": "#FF8C42" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#C8C5D6" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF5555" } }
  ]
}